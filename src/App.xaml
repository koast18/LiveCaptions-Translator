<Application
    x:Class="LiveCaptionsTranslator.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ShutdownMode="OnMainWindowClose"
    StartupUri="windows\MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <!-- The pack URI pointed at a Fonts/ folder that does not exist in this repository, so every
                 symbol fell back to a font without those glyphs and drew "?" boxes. Name the system
                 fonts instead: Windows 11 has Segoe Fluent Icons, Windows 10 ships Segoe MDL2 Assets
                 with the same codepoints for the icons used here. -->
            <FontFamily x:Key="SegoeFluentIcons">Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
