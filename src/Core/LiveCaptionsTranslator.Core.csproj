<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<RootNamespace>LiveCaptionsTranslator.Core</RootNamespace>
		<AssemblyName>LiveCaptionsTranslator.Core</AssemblyName>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<!-- The protobuf reader/writer are internal; the codec tests drive them directly. -->
		<InternalsVisibleTo Include="LiveCaptionsTranslator.Core.Tests" />
	</ItemGroup>

</Project>
