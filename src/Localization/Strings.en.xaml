    <sys:String x:Key="Nav_History">History</sys:String>
    <sys:String x:Key="Nav_Info">Info</sys:String>

    <sys:String x:Key="Setting_UiLanguage">Interface Language</sys:String>

    <sys:String x:Key="Caption_CopyTooltip">Click to Copy</sys:String>
    <sys:String x:Key="Caption_Copied">Copied.</sys:String>
    <sys:String x:Key="Caption_CopyFailed">Copy Failed.</sys:String>

    <sys:String x:Key="Setting_LiveCaptions">LiveCaptions</sys:String>
    <sys:String x:Key="Setting_LiveCaptionsNote1">After Windows 11 version 24H2, you can only change the</sys:String>
    <sys:String x:Key="Setting_LiveCaptionsNote2">Source Language</sys:String>
    <sys:String x:Key="Setting_LiveCaptionsNote3">in LiveCaptions.</sys:String>
    <sys:String x:Key="Setting_Note">&#x0A;&#x0A;Note:</sys:String>
