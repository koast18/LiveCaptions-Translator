<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--  English strings. This file is the source of truth: every key that exists here must also
          exist in Strings.zh-Hans.xaml, and the value must match what the app shipped before the
          strings were extracted.  -->

    <sys:String x:Key="App_Title">LiveCaptions Translator</sys:String>

    <sys:String x:Key="Nav_Caption">Caption</sys:String>
    <sys:String x:Key="Nav_Setting">Setting</sys:String>
    <sys:String x:Key="Nav_History">History</sys:String>
    <sys:String x:Key="Nav_Info">Info</sys:String>

    <sys:String x:Key="Setting_UiLanguage">Interface Language</sys:String>

    <sys:String x:Key="Caption_CopyTooltip">Click to Copy</sys:String>
    <sys:String x:Key="Caption_Copied">Copied.</sys:String>
    <sys:String x:Key="Caption_CopyFailed">Copy Failed.</sys:String>

    <sys:String x:Key="Setting_LiveCaptions">LiveCaptions</sys:String>
    <sys:String x:Key="Setting_LiveCaptionsNote1">After Windows 11 version 24H2, you can only change the</sys:String>
    <sys:String x:Key="Setting_LiveCaptionsNote2">Source Language</sys:String>
    <sys:String x:Key="Setting_LiveCaptionsNote3">in LiveCaptions.</sys:String>
    <sys:String x:Key="Setting_Note">&#x0A;&#x0A;Note:</sys:String>
    <sys:String x:Key="Setting_PleaseClick">Please click</sys:String>
    <sys:String x:Key="Setting_HideQuoted">&quot;Hide&quot;</sys:String>
    <sys:String x:Key="Setting_HideHint">to hide LiveCaptions instead of closing it directly.</sys:String>
    <sys:String x:Key="Setting_Show">Show</sys:String>
    <sys:String x:Key="Setting_ApiInterval">API Interval</sys:String>
    <sys:String x:Key="Setting_ApiIntervalHint1">Determines the frequency of translate API calls. The smaller it is, the more frequent API calls.</sys:String>
    <sys:String x:Key="Setting_ApiIntervalHint2">&#x0A;The translate API is called once after the caption changes</sys:String>
    <sys:String x:Key="Setting_ApiIntervalHint3">[API Interval]</sys:String>
    <sys:String x:Key="Setting_ApiIntervalHint4">times.</sys:String>
    <sys:String x:Key="Setting_TranslateApi">Translate API</sys:String>
    <sys:String x:Key="Setting_TranslateApiHint">Except for Google and Google2, all other APIs require configuring before they can be used.</sys:String>
    <sys:String x:Key="Setting_TargetLanguage">Target Language</sys:String>
    <sys:String x:Key="Setting_TargetLangHint1">&quot;There isn’t the target language I expect!&quot;</sys:String>
    <sys:String x:Key="Setting_TargetLangHint2">&#x0A;You can directly edit the content of this combobox to customize the language, and it is recommended to follow the</sys:String>
    <sys:String x:Key="Setting_TargetLangHint3">BCP 47 language tag.</sys:String>
    <sys:String x:Key="Setting_TargetLangHint4">Some of APIs (such as DeepL) needs another way to define target language, see their official docs for more details.</sys:String>
    <sys:String x:Key="Setting_TargetLangHint5">&#x0A;No need to consider this for included target languages, since we've built in tag mappings. But if your expected language isn't in the list, keep this in mind.</sys:String>
    <sys:String x:Key="Setting_ApiSetting">API Setting</sys:String>
    <sys:String x:Key="Setting_Open">Open</sys:String>
    <sys:String x:Key="Setting_ShowLatency">Show Latency</sys:String>
    <sys:String x:Key="Setting_Off">Off</sys:String>
    <sys:String x:Key="Setting_On">On</sys:String>
    <sys:String x:Key="Setting_Contexts">Contexts</sys:String>
    <sys:String x:Key="Setting_ContextsLabel">Contexts:</sys:String>
    <sys:String x:Key="Setting_ContextsHint1">Determines the number of context sentences when</sys:String>
    <sys:String x:Key="Setting_ContextAware">Context Aware</sys:String>
    <sys:String x:Key="Setting_ContextsHint2">is enabled.</sys:String>
    <sys:String x:Key="Setting_OverlaySentencesLabel">&#x0A;Overlay Sentences:</sys:String>
    <sys:String x:Key="Setting_ContextsHint3">Determines the number of displayed cards when</sys:String>
    <sys:String x:Key="Setting_LogCards">Log Cards</sys:String>
    <sys:String x:Key="Setting_ContextsHint4">is enabled, as well as the max number of sentences displayed in the Overlay Window.</sys:String>
    <sys:String x:Key="Setting_ContextsHint5">Contexts must be</sys:String>
    <sys:String x:Key="Setting_GreaterOrEqual">greater than or equal</sys:String>
    <sys:String x:Key="Setting_ContextsHint6">Display Sentences. If not met, the program will automatically adjust them.</sys:String>
    <sys:String x:Key="Setting_DisplaySentences">Display Sentences</sys:String>
    <sys:String x:Key="Setting_ContextAwareHint1">Translate in context.</sys:String>
    <sys:String x:Key="Setting_ContextAwareHint2">&#x0A;It can improve translation accuracy, but will consume more tokens.</sys:String>
    <sys:String x:Key="Setting_SpeechRecognition">Speech Recognition</sys:String>
    <sys:String x:Key="Setting_Apply">Apply</sys:String>
    <sys:String x:Key="Setting_Register">Register</sys:String>
    <sys:String x:Key="Setting_GapMs">gap(ms)</sys:String>
    <sys:String x:Key="Setting_GapTooltip">Silence before the service ends a sentence. 200 is the service default and chops at every breath; 500-800 reads better.</sys:String>
    <sys:String x:Key="Setting_NetworkProxy">Network / Proxy</sys:String>
    <sys:String x:Key="Setting_MachineTranslation">Machine Translation</sys:String>
    <sys:String x:Key="Setting_AppId">app_id</sys:String>

</ResourceDictionary>
