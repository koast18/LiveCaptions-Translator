<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--  简体中文。键集合必须与 Strings.en.xaml 完全一致。  -->

    <sys:String x:Key="App_Title">实时字幕翻译</sys:String>

    <sys:String x:Key="Nav_Caption">字幕</sys:String>
    <sys:String x:Key="Nav_Setting">设置</sys:String>
    <sys:String x:Key="Nav_History">历史</sys:String>
    <sys:String x:Key="Nav_Info">关于</sys:String>

    <sys:String x:Key="Setting_UiLanguage">界面语言</sys:String>

    <sys:String x:Key="Caption_CopyTooltip">点击复制</sys:String>
    <sys:String x:Key="Caption_Copied">已复制。</sys:String>
    <sys:String x:Key="Caption_CopyFailed">复制失败。</sys:String>

    <sys:String x:Key="Setting_LiveCaptions">LiveCaptions</sys:String>
    <sys:String x:Key="Setting_LiveCaptionsNote1">在 Windows 11 24H2 之后，只能修改</sys:String>
    <sys:String x:Key="Setting_LiveCaptionsNote2">源语言</sys:String>
    <sys:String x:Key="Setting_LiveCaptionsNote3">（在 LiveCaptions 内修改）。</sys:String>
    <sys:String x:Key="Setting_Note">&#x0A;&#x0A;注意：</sys:String>
    <sys:String x:Key="Setting_PleaseClick">请点击</sys:String>
    <sys:String x:Key="Setting_HideQuoted">&quot;隐藏&quot;</sys:String>
    <sys:String x:Key="Setting_HideHint">来隐藏 LiveCaptions，而不是直接关闭它。</sys:String>
    <sys:String x:Key="Setting_Show">显示</sys:String>
    <sys:String x:Key="Setting_ApiInterval">API 间隔</sys:String>
    <sys:String x:Key="Setting_ApiIntervalHint1">决定翻译 API 的调用频率。数值越小，调用越频繁。</sys:String>
    <sys:String x:Key="Setting_ApiIntervalHint2">&#x0A;字幕变化</sys:String>
    <sys:String x:Key="Setting_ApiIntervalHint3">[API 间隔]</sys:String>
    <sys:String x:Key="Setting_ApiIntervalHint4">次后调用一次翻译 API。</sys:String>
    <sys:String x:Key="Setting_TranslateApi">翻译 API</sys:String>
    <sys:String x:Key="Setting_TranslateApiHint">除 Google 和 Google2 外，其他 API 都需要先配置才能使用。</sys:String>
    <sys:String x:Key="Setting_TargetLanguage">目标语言</sys:String>
    <sys:String x:Key="Setting_TargetLangHint1">&quot;没有我想要的目标语言！&quot;</sys:String>
    <sys:String x:Key="Setting_TargetLangHint2">&#x0A;你可以直接编辑此下拉框的内容来自定义语言，建议遵循</sys:String>
    <sys:String x:Key="Setting_TargetLangHint3">BCP 47 语言标签。</sys:String>
    <sys:String x:Key="Setting_TargetLangHint4">部分 API（例如 DeepL）需要用另一种方式指定目标语言，详见其官方文档。</sys:String>
    <sys:String x:Key="Setting_TargetLangHint5">&#x0A;内置的目标语言已做好标签映射，无需考虑这一点；但若你想要的语言不在列表里，请注意上述情况。</sys:String>
    <sys:String x:Key="Setting_ApiSetting">API 设置</sys:String>
    <sys:String x:Key="Setting_Open">打开</sys:String>
    <sys:String x:Key="Setting_ShowLatency">显示延迟</sys:String>
    <sys:String x:Key="Setting_Off">关</sys:String>
    <sys:String x:Key="Setting_On">开</sys:String>
    <sys:String x:Key="Setting_Contexts">上下文</sys:String>
    <sys:String x:Key="Setting_ContextsLabel">上下文：</sys:String>
    <sys:String x:Key="Setting_ContextsHint1">决定启用</sys:String>
    <sys:String x:Key="Setting_ContextAware">上下文感知</sys:String>
    <sys:String x:Key="Setting_ContextsHint2">时携带的上下文句子数。</sys:String>
    <sys:String x:Key="Setting_OverlaySentencesLabel">&#x0A;悬浮窗句数：</sys:String>
    <sys:String x:Key="Setting_ContextsHint3">决定启用</sys:String>
    <sys:String x:Key="Setting_LogCards">日志卡片</sys:String>
    <sys:String x:Key="Setting_ContextsHint4">时显示的卡片数，以及悬浮窗中最多显示的句子数。</sys:String>
    <sys:String x:Key="Setting_ContextsHint5">上下文必须</sys:String>
    <sys:String x:Key="Setting_GreaterOrEqual">大于或等于</sys:String>
    <sys:String x:Key="Setting_ContextsHint6">显示句数。若不满足，程序会自动调整。</sys:String>
    <sys:String x:Key="Setting_DisplaySentences">显示句数</sys:String>
    <sys:String x:Key="Setting_ContextAwareHint1">带上下文翻译。</sys:String>
    <sys:String x:Key="Setting_ContextAwareHint2">&#x0A;可提升翻译准确度，但会消耗更多 token。</sys:String>
    <sys:String x:Key="Setting_SpeechRecognition">语音识别</sys:String>
    <sys:String x:Key="Setting_Apply">应用</sys:String>
    <sys:String x:Key="Setting_Register">注册</sys:String>
    <sys:String x:Key="Setting_GapMs">断句(毫秒)</sys:String>
    <sys:String x:Key="Setting_GapTooltip">静音多久算一句结束。200 是服务端默认值，会把每口气都切开；500-800 更自然。</sys:String>
    <sys:String x:Key="Setting_NetworkProxy">网络 / 代理</sys:String>
    <sys:String x:Key="Setting_MachineTranslation">机器翻译</sys:String>
    <sys:String x:Key="Setting_AppId">app_id</sys:String>

    <sys:String x:Key="Main_AlwaysOnTop">窗口置顶</sys:String>
    <sys:String x:Key="Main_LogCards">字幕日志卡片</sys:String>
    <sys:String x:Key="Main_OverlayWindow">悬浮窗</sys:String>
    <sys:String x:Key="Main_PauseTranslation">暂停翻译（仅记录）</sys:String>
    <sys:String x:Key="History_Refresh">刷新</sys:String>
    <sys:String x:Key="History_Export">导出</sys:String>
    <sys:String x:Key="History_DeleteAll">全部删除</sys:String>
    <sys:String x:Key="History_Previous">上一页 </sys:String>
    <sys:String x:Key="History_NextPage">下一页</sys:String>
    <sys:String x:Key="History_PerPage100">100/页</sys:String>
    <sys:String x:Key="History_PerPage50">50/页</sys:String>
    <sys:String x:Key="History_PerPage30">30/页</sys:String>
    <sys:String x:Key="History_PerPage20">20/页</sys:String>
    <sys:String x:Key="History_Time">时间</sys:String>
    <sys:String x:Key="History_Translated">译文</sys:String>
    <sys:String x:Key="Info_Contribution">欢迎任何形式的贡献！你可以通过 GitHub 提出建议或反馈问题</sys:String>
    <sys:String x:Key="Info_Star">&#x0A;如果这个程序对你有帮助，欢迎给个 star ✨！</sys:String>
    <sys:String x:Key="Info_Repository">仓库：</sys:String>
    <sys:String x:Key="Info_Wiki">Wiki：</sys:String>
    <sys:String x:Key="Info_Maintainer">维护者：</sys:String>
    <sys:String x:Key="Info_AuthorAnd">（作者）与</sys:String>
    <sys:String x:Key="Info_Version">版本：</sys:String>
    <sys:String x:Key="Overlay_FontSizeIncrease">增大字号</sys:String>
    <sys:String x:Key="Overlay_FontSizeDecrease">减小字号</sys:String>
    <sys:String x:Key="Overlay_FontStrokeIncrease">加深描边</sys:String>
    <sys:String x:Key="Overlay_FontStrokeDecrease">减淡描边</sys:String>
    <sys:String x:Key="Overlay_FontBold">粗体</sys:String>
    <sys:String x:Key="Overlay_FontColor">字体颜色</sys:String>
    <sys:String x:Key="Overlay_BgOpacityIncrease">提高背景不透明度</sys:String>
    <sys:String x:Key="Overlay_BgOpacityDecrease">降低背景不透明度</sys:String>
    <sys:String x:Key="Overlay_BgColor">背景颜色</sys:String>
    <sys:String x:Key="Overlay_OnlyTranslation">仅显示原文或译文</sys:String>
    <sys:String x:Key="Overlay_SwapOrder">交换原文与译文的顺序</sys:String>
    <sys:String x:Key="Overlay_ClickThrough">鼠标穿透</sys:String>

</ResourceDictionary>
