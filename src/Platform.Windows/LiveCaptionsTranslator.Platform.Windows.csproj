<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
		<!-- UI Automation (System.Windows.Automation) and the Win32 P/Invoke helpers live here. -->
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<RootNamespace>LiveCaptionsTranslator.Platform.Windows</RootNamespace>
		<AssemblyName>LiveCaptionsTranslator.Platform.Windows</AssemblyName>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core\LiveCaptionsTranslator.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- WASAPI loopback / microphone capture. -->
		<PackageReference Include="NAudio" Version="2.2.1" />
	</ItemGroup>

</Project>
