<Page
    x:Class="LiveCaptionsTranslator.CaptionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="CaptionPage"
    mc:Ignorable="d">

    <Grid Margin="4,4,4,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <!--  A local Style replaces the implicit one, so Foreground has to be set here or the
                  previous lines fall back to black and vanish on a dark background.  -->
            <Style x:Key="CaptionBlockStyle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
        </Grid.Resources>

        <!--  What the app itself has to say (an error, "paused", a fallback warning). It has its
              own row so it is never mistaken for a caption and never scrolls away with them.  -->
        <TextBlock
            Grid.Row="0"
            Margin="6,0,6,2"
            FontSize="12"
            Opacity="0.75"
            Text="{Binding Notice}"
            TextWrapping="Wrap">
            <TextBlock.Style>
                <Style BasedOn="{StaticResource CaptionBlockStyle}" TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasNotice}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!--  Rolling, lyrics-style view: the line being spoken is highlighted, the previous ones
              fade out, and the list scrolls so the newest line is always at the bottom.  -->
        <ScrollViewer
            x:Name="RollingScroll"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Hidden">
            <StackPanel>
            <ItemsControl x:Name="RollingItems" ItemsSource="{Binding RollingLines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Margin="6,1"
                            Cursor="Hand"
                            MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                            Text="{Binding Text}"
                            ToolTip="{DynamicResource Caption_CopyTooltip}">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource CaptionBlockStyle}" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="16" />
                                    <Setter Property="Opacity" Value="0.5" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLatest}" Value="True">
                                            <Setter Property="FontSize" Value="19" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

                <!--  Live recognition, in its own slot: it changes with every chunk and must never
                      push a translated sentence out of the way. Hidden while nothing is being heard.  -->
                <TextBlock
                    x:Name="LiveLine"
                    Margin="6,2,6,2"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    Text="{Binding InterimText}"
                    TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource CaptionBlockStyle}" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Top" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InterimText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
