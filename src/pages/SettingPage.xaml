<Page
    x:Class="LiveCaptionsTranslator.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="SettingPage"
    JournalEntry.KeepAlive="False"
    mc:Ignorable="d">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  WrapPanel, not five grid columns: at the default window size five columns overflowed
              the page and left wide gaps between the controls. Wrapping keeps every item on screen.  -->
        <WrapPanel Grid.Row="0" Grid.ColumnSpan="5" Orientation="Horizontal">
        <StackPanel Margin="0,0,22,14" Orientation="Vertical">
            <StackPanel Margin="15,0,0,0" Orientation="Vertical">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Margin="2.5,0,0,5" Text="LiveCaptions" />
                    <ui:Flyout x:Name="LiveCaptionsInfoFlyout">
                        <TextBlock MaxWidth="300" TextWrapping="Wrap">
                            <Run Text="{DynamicResource Setting_LiveCaptionsNote1}" />
                            <Run FontWeight="DemiBold" TextDecorations="Underline" Text="{DynamicResource Setting_LiveCaptionsNote2}" />
                            <Run Text="{DynamicResource Setting_LiveCaptionsNote3}" />
                            <Run FontWeight="Bold" Text="{DynamicResource Setting_Note}" />
                            <Run Text="{DynamicResource Setting_PleaseClick}" />
                            <Run FontWeight="Bold" Text="{DynamicResource Setting_HideQuoted}" />
                            <Run Text="{DynamicResource Setting_HideHint}" />
                        </TextBlock>
                    </ui:Flyout>
                    <Button
                        x:Name="LiveCaptionsInfo"
                        Width="15"
                        HorizontalAlignment="Left"
                        Height="15"
                        Margin="-5,-3,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        MouseEnter="LiveCaptionsInfo_MouseEnter"
                        MouseLeave="LiveCaptionsInfo_MouseLeave">
                        <ui:SymbolIcon Symbol="Info16" />
                    </Button>
                </StackPanel>
                <ui:Button
                    x:Name="LiveCaptionsButton"
                    Width="120"
                    HorizontalAlignment="Left"
                    Height="30"
                    Padding="11,4,11,4"
                    Click="LiveCaptionsButton_click">
                    <TextBlock x:Name="ButtonText" Text="{DynamicResource Setting_Show}" />
                </ui:Button>
            </StackPanel>

            <StackPanel Margin="15,10,0,0" Orientation="Vertical">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Margin="2.5,0,0,5" Text="{DynamicResource Setting_ApiInterval}" />
                    <ui:Flyout x:Name="FrequencyInfoFlyout">
                        <TextBlock MaxWidth="300" TextWrapping="Wrap">
                            <Run Text="{DynamicResource Setting_ApiIntervalHint1}" />
                            <Run Text="{DynamicResource Setting_ApiIntervalHint2}" />
                            <Run FontWeight="SemiBold" Text="{DynamicResource Setting_ApiIntervalHint3}" />
                            <Run Text="{DynamicResource Setting_ApiIntervalHint4}" />
                        </TextBlock>
                    </ui:Flyout>
                    <Button
                        x:Name="FrequencyInfo"
                        Width="15"
                        HorizontalAlignment="Left"
                        Height="15"
                        Margin="-5,-3,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        MouseEnter="FrequencyInfo_MouseEnter"
                        MouseLeave="FrequencyInfo_MouseLeave">
                        <ui:SymbolIcon Symbol="Info16" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Slider
                        Width="120"
                        HorizontalAlignment="Left"
                        Margin="0,0,5,0"
                        AutoToolTipPlacement="TopLeft"
                        AutoToolTipPrecision="0"
                        Maximum="10"
                        Value="{Binding MaxSyncInterval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel Margin="0,0,22,14" Orientation="Vertical">
            <StackPanel Margin="15,0,0,0" Orientation="Vertical">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Margin="2.5,0,0,5" Text="{DynamicResource Setting_TranslateApi}" />
                    <ui:Flyout x:Name="TranslateAPIInfoFlyout">
                        <TextBlock
                            MaxWidth="300"
                            Text="{DynamicResource Setting_TranslateApiHint}"
                            TextWrapping="Wrap" />
                    </ui:Flyout>
                    <Button
                        x:Name="TranslateAPIInfo"
                        Width="15"
                        HorizontalAlignment="Left"
                        Height="15"
                        Margin="-5,-3,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        MouseEnter="TranslateAPIInfo_MouseEnter"
                        MouseLeave="TranslateAPIInfo_MouseLeave">
                        <ui:SymbolIcon Symbol="Info16" />
                    </Button>
                </StackPanel>
                <ComboBox
                    x:Name="TranslateAPIBox"
                    Width="150"
                    HorizontalAlignment="Left"
                    Height="30"
                    Padding="10,4,10,7"
                    FontSize="13.3"
                    SelectedItem="{Binding ApiName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectionChanged="TranslateAPIBox_SelectionChanged" />
            </StackPanel>

            <StackPanel Margin="15,10,0,0" Orientation="Vertical">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="2.5,0,0,5"
                        VerticalAlignment="Center"
                        Text="{DynamicResource Setting_TargetLanguage}" />
                    <ui:Flyout x:Name="TargetLangInfoFlyout">
                        <TextBlock MaxWidth="350" TextWrapping="Wrap">
                            <Run FontWeight="DemiBold" TextDecorations="Underline" Text="{DynamicResource Setting_TargetLangHint1}" />
                            <Run Text="{DynamicResource Setting_TargetLangHint2}" />
                            <Run FontWeight="Bold" Text="{DynamicResource Setting_TargetLangHint3}" />
                            <Run FontWeight="Bold" Text="{DynamicResource Setting_Note}" />
                            <Run Text="{DynamicResource Setting_TargetLangHint4}" />
                            <Run Text="{DynamicResource Setting_TargetLangHint5}" />
                        </TextBlock>
                    </ui:Flyout>
                    <Button
                        x:Name="TargetLangInfo"
                        Width="15"
                        HorizontalAlignment="Left"
                        Height="15"
                        Margin="-5,-3,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        MouseEnter="TargetLangInfo_MouseEnter"
                        MouseLeave="TargetLangInfo_MouseLeave">
                        <ui:SymbolIcon Symbol="Info16" />
                    </Button>
                </StackPanel>
                <ComboBox
                    x:Name="TargetLangBox"
                    Width="150"
                    HorizontalAlignment="Left"
                    Height="30"
                    Padding="10,4,10,7"
                    FontSize="13.3"
                    IsEditable="True"
                    LostFocus="TargetLangBox_LostFocus"
                    SelectionChanged="TargetLangBox_SelectionChanged" />
            </StackPanel>
        </StackPanel>

        <StackPanel Margin="0,0,22,14" Orientation="Vertical">
            <StackPanel Margin="15,0,0,0" Orientation="Vertical">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Margin="2.5,0,0,5" Text="{DynamicResource Setting_ApiSetting}" />
                </StackPanel>
                <ui:Button
                    x:Name="APISettingButton"
                    Width="100"
                    HorizontalAlignment="Left"
                    Height="30"
                    Padding="11,4,11,4"
                    Click="APISettingButton_click">
                    <TextBlock Text="{DynamicResource Setting_Open}" />
                </ui:Button>
            </StackPanel>
            <StackPanel Margin="15,10,0,0" Orientation="Vertical">
                <TextBlock Margin="2.5,0,0,5" Text="{DynamicResource Setting_ShowLatency}" />
                <ui:ToggleSwitch
                    Width="100"
                    HorizontalAlignment="Left"
                    Height="30"
                    Padding="10,4,10,7"
                    IsChecked="{Binding MainWindow.LatencyShow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    OffContent="{DynamicResource Setting_Off}"
                    OnContent="{DynamicResource Setting_On}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Margin="0,0,22,14" Orientation="Vertical">
            <StackPanel Margin="15,0,0,0" Orientation="Vertical">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Margin="2.5,0,0,5" Text="{DynamicResource Setting_Contexts}" />
                    <ui:Flyout x:Name="CaptionLogMaxInfoFlyout">
                        <TextBlock MaxWidth="300" TextWrapping="Wrap">
                            <Run FontWeight="Bold" Text="{DynamicResource Setting_ContextsLabel}" />
                            <Run Text="{DynamicResource Setting_ContextsHint1}" />
                            <Run FontWeight="Bold" Text="{DynamicResource Setting_ContextAware}" />
                            <Run Text="{DynamicResource Setting_ContextsHint2}" />
                            <Run FontWeight="Bold" Text="{DynamicResource Setting_OverlaySentencesLabel}" />
                            <Run Text="{DynamicResource Setting_ContextsHint3}" />
                            <Run FontWeight="Bold" Text="{DynamicResource Setting_LogCards}" />
                            <Run Text="{DynamicResource Setting_ContextsHint4}" />
                            <Run FontWeight="Bold" Text="{DynamicResource Setting_Note}" />
                            <Run Text="{DynamicResource Setting_ContextsHint5}" />
                            <Run FontWeight="Bold" Text="{DynamicResource Setting_GreaterOrEqual}" />
                            <Run Text="{DynamicResource Setting_ContextsHint6}" />
                        </TextBlock>
                    </ui:Flyout>
                    <Button
                        x:Name="CaptionLogMaxInfo"
                        Width="15"
                        HorizontalAlignment="Left"
                        Height="15"
                        Margin="-5,-3,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        MouseEnter="CaptionLogMaxInfo_MouseEnter"
                        MouseLeave="CaptionLogMaxInfo_MouseLeave">
                        <ui:SymbolIcon Symbol="Info16" />
                    </Button>
                </StackPanel>
                <ui:NumberBox
                    Width="135"
                    HorizontalAlignment="Left"
                    Height="30"
                    Padding="10,4,10,7"
                    FontSize="13.3"
                    ClearButtonEnabled="False"
                    AcceptsExpression="False"
                    SpinButtonPlacementMode="Inline"
                    Maximum="10"
                    Minimum="1"
                    LargeChange="1"
                    SmallChange="1"
                    Value="{Binding NumContexts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ValueChanged="Contexts_ValueChanged" />
            </StackPanel>

            <StackPanel Margin="15,10,0,0" Orientation="Vertical">
                <TextBlock Margin="2.5,0,0,5" Text="{DynamicResource Setting_DisplaySentences}" />
                <ui:NumberBox
                    Width="135"
                    HorizontalAlignment="Left"
                    Height="30"
                    Padding="10,4,10,7"
                    FontSize="13.3"
                    ClearButtonEnabled="False"
                    AcceptsExpression="False"
                    SpinButtonPlacementMode="Inline"
                    Maximum="6"
                    Minimum="0"
                    LargeChange="1"
                    SmallChange="1"
                    Value="{Binding DisplaySentences, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ValueChanged="DisplaySentences_ValueChanged" />
            </StackPanel>
        </StackPanel>

        <StackPanel Margin="0,0,22,14" Orientation="Vertical">
            <StackPanel Margin="15,0,0,0" Orientation="Vertical">
                <TextBlock Margin="2.5,0,0,5" Text="{DynamicResource Setting_ContextAware}" />
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:ToggleSwitch
                        Width="90"
                        HorizontalAlignment="Left"
                        Height="30"
                        Padding="10,4,10,7"
                        IsChecked="{Binding ContextAware, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        OffContent="{DynamicResource Setting_Off}"
                        OnContent="{DynamicResource Setting_On}" />
                    <Button
                        x:Name="ContextAwareInfo"
                        Width="15"
                        HorizontalAlignment="Left"
                        Height="15"
                        Margin="-5,-3,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        MouseEnter="ContextAwareInfo_MouseEnter"
                        MouseLeave="ContextAwareInfo_MouseLeave">
                        <ui:SymbolIcon Symbol="Info16" />
                    </Button>
                    <ui:Flyout x:Name="ContextAwareInfoFlyout">
                        <TextBlock MaxWidth="300" TextWrapping="Wrap">
                            <Run Text="{DynamicResource Setting_ContextAwareHint1}" />
                            <Run Text="{DynamicResource Setting_ContextAwareHint2}" />
                        </TextBlock>
                    </ui:Flyout>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        </WrapPanel>

        <!--  Speech recognition backend. Spans every column so it reads as one row below the
              existing settings and does not disturb the upstream three-column layout.  -->
        <StackPanel
            Grid.Row="1"
            Grid.ColumnSpan="5"
            Margin="15,15,0,0"
            Orientation="Vertical">
            <TextBlock Margin="2.5,0,0,5" Text="{DynamicResource Setting_SpeechRecognition}" />
            <StackPanel Orientation="Horizontal">
                <ComboBox
                    x:Name="AsrProviderBox"
                    Width="170"
                    Height="30"
                    Padding="10,4,10,7"
                    FontSize="13.3"
                    SelectionChanged="AsrProviderBox_SelectionChanged" />
                <ComboBox
                    x:Name="AsrLanguageBox"
                    Width="190"
                    Height="30"
                    Margin="10,0,0,0"
                    Padding="10,4,10,7"
                    FontSize="13.3"
                    SelectionChanged="AsrLanguageBox_SelectionChanged" />
                <ComboBox
                    x:Name="AudioSourceBox"
                    Width="190"
                    Height="30"
                    Margin="10,0,0,0"
                    Padding="10,4,10,7"
                    FontSize="13.3"
                    SelectionChanged="AudioSourceBox_SelectionChanged" />
            </StackPanel>
            <StackPanel
                x:Name="IflytekCredentialPanel"
                Margin="0,8,0,0"
                Orientation="Horizontal"
                Visibility="Collapsed">
                <TextBlock
                    Margin="2.5,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    Text="api_key" />
                <TextBox
                    x:Name="IflytekApiKeyBox"
                    Width="200"
                    Height="30"
                    Margin="8,0,0,0"
                    Padding="8,4,8,4"
                    FontSize="12.5" />
                <TextBlock
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    Text="api_secret" />
                <TextBox
                    x:Name="IflytekApiSecretBox"
                    Width="200"
                    Height="30"
                    Margin="8,0,0,0"
                    Padding="8,4,8,4"
                    FontSize="12.5" />
                <ui:Button
                    x:Name="AsrApplyButton"
                    Height="30"
                    Margin="10,0,0,0"
                    Padding="11,4,11,4"
                    Click="AsrApplyButton_click">
                    <TextBlock Text="{DynamicResource Setting_Apply}" />
                </ui:Button>
            </StackPanel>
            <StackPanel
                x:Name="DoubaoCredentialPanel"
                Margin="0,8,0,0"
                Orientation="Horizontal"
                Visibility="Collapsed">
                <TextBlock
                    Margin="2.5,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    Text="device_id" />
                <TextBox
                    x:Name="DoubaoDeviceIdBox"
                    Width="170"
                    Height="30"
                    Margin="8,0,0,0"
                    Padding="8,4,8,4"
                    FontSize="12.5" />
                <TextBlock
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    Text="app_key" />
                <TextBox
                    x:Name="DoubaoAppKeyBox"
                    Width="170"
                    Height="30"
                    Margin="8,0,0,0"
                    Padding="8,4,8,4"
                    FontSize="12.5" />
                <ui:Button
                    x:Name="DoubaoRegisterButton"
                    Height="30"
                    Margin="10,0,0,0"
                    Padding="11,4,11,4"
                    Click="DoubaoRegisterButton_click">
                    <TextBlock Text="{DynamicResource Setting_Register}" />
                </ui:Button>
                <ui:Button
                    x:Name="DoubaoApplyButton"
                    Height="30"
                    Margin="8,0,0,0"
                    Padding="11,4,11,4"
                    Click="DoubaoApplyButton_click">
                    <TextBlock Text="{DynamicResource Setting_Apply}" />
                </ui:Button>
                <TextBlock
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    Text="{DynamicResource Setting_GapMs}" />
                <TextBox
                    x:Name="DoubaoVadBox"
                    Width="60"
                    Height="30"
                    Margin="8,0,0,0"
                    Padding="8,4,8,4"
                    FontSize="12.5"
                    ToolTip="{DynamicResource Setting_GapTooltip}" />
            </StackPanel>

            <TextBlock
                x:Name="AsrHintText"
                Margin="2.5,6,0,0"
                FontSize="11.5"
                Opacity="0.7"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  Interface language. Swapping the merged string dictionary updates every open window.  -->
        <StackPanel
            Grid.Row="4"
            Grid.ColumnSpan="5"
            Margin="15,15,0,0"
            Orientation="Vertical">
            <TextBlock Margin="2.5,0,0,5" Text="{DynamicResource Setting_UiLanguage}" />
            <ComboBox
                x:Name="UiLanguageBox"
                Width="170"
                HorizontalAlignment="Left"
                Height="30"
                Padding="10,4,10,7"
                FontSize="13.3"
                DisplayMemberPath="DisplayName"
                SelectionChanged="UiLanguageBox_SelectionChanged" />
        </StackPanel>

        <!--  Proxy. Google / OpenAI / OpenRouter / DeepL are unreachable from some networks,
              so the user picks one proxy URL and ticks the engines that must use it.  -->
        <StackPanel
            Grid.Row="2"
            Grid.ColumnSpan="5"
            Margin="15,15,0,0"
            Orientation="Vertical">
            <TextBlock Margin="2.5,0,0,5" Text="{DynamicResource Setting_NetworkProxy}" />
            <WrapPanel Orientation="Horizontal">
                <TextBox
                    x:Name="ProxyBox"
                    Width="260"
                    Height="30"
                    Padding="8,4,8,4"
                    FontSize="12.5"
                    LostFocus="ProxyBox_LostFocus" />
                <TextBlock
                    x:Name="ProxyHintText"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="11.5"
                    Opacity="0.7" />
            </WrapPanel>
            <WrapPanel
                x:Name="ProxyTargetsPanel"
                Margin="0,8,0,0"
                Orientation="Horizontal" />
        </StackPanel>

        <!--  iFlytek machine translation needs its own 开放平台 account; the anonymous IAT
              credentials do not work here, so the fields stay empty until the user fills them.  -->
        <StackPanel
            Grid.Row="3"
            Grid.ColumnSpan="5"
            Margin="15,15,0,0"
            Orientation="Vertical">
            <TextBlock Margin="2.5,0,0,5" Text="{DynamicResource Setting_MachineTranslation}" />
            <WrapPanel Orientation="Horizontal">
                <TextBlock
                    Margin="2.5,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    Text="app_id" />
                <TextBox
                    x:Name="IflytekMtAppIdBox"
                    Width="140"
                    Height="30"
                    Margin="8,0,0,0"
                    Padding="8,4,8,4"
                    FontSize="12.5" />
                <TextBlock
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    Text="api_key" />
                <TextBox
                    x:Name="IflytekMtApiKeyBox"
                    Width="140"
                    Height="30"
                    Margin="8,0,0,0"
                    Padding="8,4,8,4"
                    FontSize="12.5" />
                <TextBlock
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    Text="api_secret" />
                <TextBox
                    x:Name="IflytekMtApiSecretBox"
                    Width="140"
                    Height="30"
                    Margin="8,0,0,0"
                    Padding="8,4,8,4"
                    FontSize="12.5" />
                <ui:Button
                    x:Name="IflytekMtApplyButton"
                    Height="30"
                    Margin="10,0,0,0"
                    Padding="11,4,11,4"
                    Click="IflytekMtApplyButton_click">
                    <TextBlock Text="{DynamicResource Setting_Apply}" />
                </ui:Button>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Page>
