<ui:FluentWindow
    x:Class="LiveCaptionsTranslator.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Welcome_GettingStarted}"
    Width="700"
    Height="490"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    WindowBackdropType="None"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Height="27"
            ShowMaximize="False"
            ShowMinimize="False">
            <ui:TitleBar.Header>
                <ui:TextBlock
                    Padding="15,0,0,0"
                    VerticalAlignment="Center"
                    Text="{DynamicResource Welcome_GettingStarted}" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Background="{ui:ThemeResource SystemFillColorNeutralBackgroundBrush}">
            <TextBlock
                Margin="20"
                HorizontalAlignment="Left"
                FontSize="24"
                FontWeight="Bold"
                Text="{DynamicResource Welcome_Title}"
                TextAlignment="Left" />
            <ui:TextBlock
                Margin="20,10,20,10"
                TextAlignment="Left"
                TextWrapping="Wrap">
                <Run Text="{DynamicResource Welcome_BasedOn}" />
                <Run Text="{DynamicResource Welcome_Intro}" />
                <Run Text="{DynamicResource Welcome_Step1}" />
                <Run Text="{DynamicResource Welcome_Step2}" />
                <Run FontWeight="Bold" Text="{DynamicResource Welcome_Gear}" />
                <Run Text="{DynamicResource Welcome_Step2b}" />
                <Run FontWeight="Bold" Text="{DynamicResource Welcome_Position}" />
                <Run Text="{DynamicResource Welcome_Step3}" />
                <Run FontWeight="Bold" Text="{DynamicResource Setting_HideQuoted}" />
                <Run Text="{DynamicResource Welcome_Step3b}" />
                <Run Text="{DynamicResource Welcome_AutoNav}" />
                <Run Text="{DynamicResource Welcome_Done}" />
                <Run Text="{DynamicResource Welcome_Wiki}" />
                <Hyperlink NavigateUri="https://github.com/SakiRinn/LiveCaptions-Translator/wiki" RequestNavigate="Hyperlink_RequestNavigate">
                    https://github.com/SakiRinn/LiveCaptions-Translator/wiki
                </Hyperlink>
                <Run FontWeight="Bold" Text="{DynamicResource Welcome_Tip}" />
                <Run Text="{DynamicResource Welcome_ToChange}" />
                <Run FontWeight="DemiBold" TextDecorations="Underline" Text="{DynamicResource Setting_LiveCaptionsNote2}" />
                <Run Text="{DynamicResource Welcome_ShowHint}" />
            </ui:TextBlock>

            <ui:Button
                Margin="0,10,0,0"
                Padding="30,10,30,10"
                HorizontalAlignment="Center"
                Click="CloseButton_Click"
                Content="{DynamicResource Welcome_Understood}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>