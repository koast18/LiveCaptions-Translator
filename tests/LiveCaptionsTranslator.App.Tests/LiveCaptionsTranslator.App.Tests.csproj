<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
		<RootNamespace>LiveCaptionsTranslator.App.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
	</ItemGroup>

	<ItemGroup>
		<!-- The dictionaries are parsed by the parity test. -->
		<None Include="..\..\src\**\*.xaml"
		      Exclude="..\..\src\Localization\Strings.*.xaml"
		      Link="XamlUnderTest\%(RecursiveDir)%(Filename)%(Extension)"
		      CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\src\Localization\Strings.*.xaml"
		      Link="Localization\%(Filename)%(Extension)"
		      CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<!-- Recorded recognition streams, replayed by the pipeline tests. -->
		<None Include="..\fixtures\*.txt"
		      Link="fixtures\%(Filename)%(Extension)"
		      CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\LiveCaptionsTranslator.csproj" />
	</ItemGroup>

</Project>
